{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "news-bot-quake",
  "main": "src/index.ts",
  "compatibility_date": "2026-01-15",
  "compatibility_flags": ["nodejs_compat"],

  "triggers": {
    "crons": [
      "* * * * *",     // 毎分: JMA (Tier 1) + NHK (Tier 3) の速報監視
      "0 * * * *"      // 毎時 0 分: filler (猫画像 + 軽ニュース)
    ]
  },

  "vars": {
    // 震度この値以上で通知 (1|2|3|4|5弱|5強|6弱|6強|7 → 内部で数値化)
    "MIN_SHINDO": "5強",
    // 津波警報/注意報は震度に関係なく必ず投稿
    "TSUNAMI_ALWAYS_POST": "true"
  },

  "kv_namespaces": [
    {
      "binding": "SEEN",
      "id": "bd240d5fdd6e403ebfa383c045b188ed"
    }
  ],

  "observability": {
    "enabled": true
  }

  // secrets (別途 wrangler secret put で登録):
  //   DISCORD_WEBHOOK_URL
}
